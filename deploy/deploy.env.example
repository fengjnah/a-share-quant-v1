# Copy outside the repository; owner must be the deployment user, chmod 600.
# Provisioning and credentials are operator-controlled; this file is never sourced automatically.
REPO_DIR=/opt/a-share-quant-workbench/repository
RELEASES_DIR=/opt/a-share-quant-workbench/releases
CURRENT_LINK=/opt/a-share-quant-workbench/current
DATA_DIR=/var/lib/a-share-quant-workbench
SERVICE=a-share-quant-workbench.service
PYTHON_BIN=/usr/bin/python3.14
HTTPS_URL=https://YOUR_EXISTING_DOMAIN/quant
AUTH_CURL_CONFIG=/home/ubuntu/.config/a-share-quant-workbench/health.curl
LOCAL_HEALTH_URL=http://127.0.0.1:8513/quant/_stcore/health
# Optional: test local Nginx with its real public certificate before ingress is allowed.
# This is NOT proof that a phone can access the public endpoint.
# TLS_RESOLVE=YOUR_EXISTING_DOMAIN:443:127.0.0.1
