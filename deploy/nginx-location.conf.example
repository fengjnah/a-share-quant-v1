# Add only inside an existing, certificate-verified HTTPS server after access control is ready.
# This file is never installed by update-workbench.sh. Keep existing routes intact.
location /quant/ {
    auth_basic "Private research workbench";
    auth_basic_user_file /etc/nginx/private-workbench.htpasswd;
    proxy_pass http://127.0.0.1:8513;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
}
