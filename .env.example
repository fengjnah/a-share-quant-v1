# Template only: .env is NOT automatically loaded. Set these in your shell.
QUANT_DB_ENV=local
QUANT_DB_PATH=./data/sqlite/local.sqlite3
QUANT_DB_JOURNAL=WAL
# Production requires an explicit path; unit tests use tmp_path, never this file.
# Windows formal workbench AFTER reviewed relocation (not an initialization command):
# AI_TRADE_DATA_ROOT=F:/codex-agnes/AI-trade-data
# AI_TRADE_STRICT_WORKBENCH=1
# AI_TRADE_READ_ONLY=1
# QUANT_DB_JOURNAL=DELETE
# With DATA_ROOT, remove QUANT_DB_PATH or set it to DATA_ROOT/sqlite/workbench.sqlite3.
# An inherited AI_TRADE_WORKBENCH_ROOT must equal DATA_ROOT/sqlite; conflicts stop.
